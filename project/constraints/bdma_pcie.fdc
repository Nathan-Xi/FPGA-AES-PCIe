######### BEGIN Clocks ########
## PCIe
create_clock -name {refclk} [get_pins {u_bdma_core_top.u_bdma_pcie_ip.u_pcie_top.u_phy.U1_L_HSSTHP_TOP/P_REFCK2CORE_0}] -period {10.000} -waveform {0.000 5.000}
create_clock -name {pclk} [get_pins {u_bdma_core_top.u_bdma_pcie_ip.u_pcie_top.u_phy.U1_L_HSSTHP_TOP/P_RCLK2FABRIC_0}] -period {2.000} -waveform {0.000 1.000}
create_clock -name {pclk_div2} [get_pins {u_bdma_core_top.u_bdma_pcie_ip.u_pcie_top.u_phy.U1_L_HSSTHP_TOP/P_TCLK2FABRIC_0}] -period {4.000} -waveform {0.000 2.000}


######### END Clocks ########


######### BEGIN "Generated Clocks" ########

create_generated_clock -name {user_clk}  -source [get_pins {u_bdma_core_top.u_bdma_pcie_ip.u_pcie_top.u_phy.U1_L_HSSTHP_TOP/P_REFCK2CORE_0}] [get_pins {u_bdma_core_top.u_user_clk_pll.clkout2}] -master_clock [get_clocks {refclk}] -multiply_by {5} -divide_by {2}
######### END "Generated Clocks" ########


######### BEGIN "Clock Group" ########

set_clock_groups -name group_0 -asynchronous -group [get_clocks {user_clk}]
set_clock_groups -name group_1 -asynchronous -group [get_clocks {pclk}]
set_clock_groups -name group_2 -asynchronous -group [get_clocks {pclk_div2}]
set_clock_groups -name group_3 -asynchronous -group [get_clocks {refclk}]

######### END "Clock Group ########





######### BEGIN "Io Table" ########
