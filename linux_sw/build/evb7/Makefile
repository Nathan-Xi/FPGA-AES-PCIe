####### Compile

main.o: ../../src/main.cpp ../../src/mainwindow.h \
		../../src/aes_device.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../src/main.cpp

mainwindow.o: ../../src/mainwindow.cpp ../../src/mainwindow.h \
		../../src/aes_device.h \
		../../src/aes_soft.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../../src/mainwindow.cpp

aes_device.o: ../../src/aes_device.cpp ../../src/aes_device.h \
		../../src/aes_soft.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o aes_device.o ../../src/aes_device.cpp

aes_soft.o: ../../src/aes_soft.cpp ../../src/aes_soft.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o aes_soft.o ../../src/aes_soft.cpp

